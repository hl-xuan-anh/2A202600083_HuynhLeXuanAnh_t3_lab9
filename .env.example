# ===== Required =====
# OpenAI API key used by the RAG pipeline (indexing + querying).
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE

# ===== Optional (Lab defaults) =====
# These are NOT required by the current code, but document the intended lab layout.
# Docs are loaded from ./docs and the vector store is persisted to ./vectorstore.
DOCS_DIR=docs
VECTORSTORE_DIR=vectorstore

# Model used for answer generation (the lab code uses gpt-4o-mini by default).
RAG_CHAT_MODEL=gpt-4o-mini

# Retrieval settings (the lab code uses top_k=3 by default).
RAG_TOP_K=3

